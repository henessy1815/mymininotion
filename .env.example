# 환경변수 템플릿 — .claude/hooks/env-example.mjs 가 자동 관리합니다.
# 실제 값은 .env.local 에 넣고, 이 파일에는 값을 적지 마세요.

# 코드에서 참조 중인 변수
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# 글 상세 커버 이미지 주소 (비우면 기본값 https://cataas.com/cat/cute 사용)
NEXT_PUBLIC_COVER_IMAGE_URL=

# 프로필 이미지 다운로드 URL 앞부분 (스토리지 주소 ~ 버킷명까지, 끝 / 없이)
# 예: https://<프로젝트ID>.supabase.co/storage/v1/object/public/profile-image
# 뒷부분(버킷명 이후 파일명)은 profile.image_path 컬럼에 저장된다.
NEXT_PUBLIC_PROFILE_IMAGE_BASE_URL=
